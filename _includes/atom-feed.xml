{%- include i18n.html -%}
{%- if page.lang -%}
  {%- assign feed_posts = site.posts | where: "lang", page.lang -%}
  {%- assign feed_subtitle = translations.site_description -%}
  {%- assign feed_home = translations.home_path -%}
{%- else -%}
  {%- assign feed_posts = site.posts -%}
  {%- assign feed_subtitle = site.description -%}
  {%- assign feed_home = '/' -%}
{%- endif -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom"{% if page.lang %} xml:lang="{{ translations.html_lang }}"{% endif %}>
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <link href="{{ page.url | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ feed_home | absolute_url }}" rel="alternate" type="text/html" />
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ page.url | absolute_url | xml_escape }}</id>
  <title type="html">{{ site.title | xml_escape }}</title>
  <subtitle>{{ feed_subtitle | xml_escape }}</subtitle>
  <author>
    <name>{{ site.author | xml_escape }}</name>
  </author>
  {%- for post in feed_posts limit: site.feed.posts_limit %}
  {%- assign post_translations = site.data.translations[post.lang] | default: translations %}
  <entry xml:lang="{% if page.lang %}{{ post_translations.html_lang }}{% else %}{{ post.lang }}{% endif %}">
    <title type="html">{{ post.title | smartify | strip_html | normalize_whitespace | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html" title="{{ post.title | xml_escape }}" />
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <id>{{ post.id | absolute_url | xml_escape }}</id>
    <content type="html" xml:base="{{ post.url | absolute_url | xml_escape }}">{{ post.content | strip | xml_escape }}</content>
    <author>
      <name>{{ post.author | default: site.author | xml_escape }}</name>
    </author>
    {%- if post.category %}
    <category term="{{ post_translations.categories[post.category] | default: post.category | xml_escape }}" />
    {%- endif %}
    <summary type="html">{{ post.excerpt | strip_html | normalize_whitespace | xml_escape }}</summary>
  </entry>
  {%- endfor %}
</feed>
